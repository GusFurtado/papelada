# Copy to .env and adjust. docker compose reads it automatically.

# Folder on this machine where your documents are kept (create it first).
DOCUMENTS_PATH=./documents

# Port Papelada is served on.
PORT=8080

# Owner of the files Papelada writes: run `id -u` and `id -g`.
PUID=1000
PGID=1000

# Optional, enables encryption. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
